{
  "name": "@querylens/engine",
  "version": "0.1.0",
  "description": "QueryLens's toy database engine: a SQL parser, planner, optimizer, buffer pool, B+Tree and lock manager that emits a trace of every step. Pure and deterministic; no DOM, no React.",
