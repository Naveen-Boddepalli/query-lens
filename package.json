{
  "name": "querylens",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "querylens": "bin/querylens.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "querylens": "node --experimental-strip-types bin/querylens.ts",
    "trace": "node --experimental-strip-types bin/querylens.ts",
    "budget": "node --experimental-strip-types scripts/bundle-budget.ts",
    "og": "node --experimental-strip-types scripts/build-og.ts",
    "record": "node --experimental-strip-types scripts/record.ts",
    "test:cli": "node --experimental-strip-types bin/querylens.ts --help",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@lezer/highlight": "1.2.3",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "d3-hierarchy": "3.1.2",
    "flowinger": "github:Naveen-Boddepalli/flowinger#d132971216597d46ece7dc563fc19bc8e28e2c7c",
    "html-to-image": "1.11.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "fast-check": "4.9.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "overrides": {
      "@codemirror/state": "6.7.4",
      "@codemirror/view": "6.43.11"
    }
  }
}
