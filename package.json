{
  "name": "querylens",
  "private": true,
  "version": "2.0.0",
  "description": "QueryLens — a database internals visualizer: watch a SQL query travel through a real (toy) engine — parser, planner, buffer pool, B+Tree index — one step at a time, in the browser.",
  "homepage": "https://query-lens.1234naveenboddepalli.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naveen-Boddepalli/query-lens.git"
  },
  "bugs": {
    "url": "https://github.com/Naveen-Boddepalli/query-lens/issues"
  },
  "keywords": [
    "database-internals",
    "sql",
    "visualization",
    "b-tree",
    "buffer-pool",
    "query-planner",
    "education"
  ],
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "querylens": "bin/querylens.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "querylens": "node --experimental-strip-types bin/querylens.ts",
    "mcp": "node --experimental-strip-types mcp/server.ts",
    "trace": "node --experimental-strip-types bin/querylens.ts",
    "budget": "node --experimental-strip-types scripts/bundle-budget.ts",
    "og": "node --experimental-strip-types scripts/build-og.ts",
    "llms-txt": "node --experimental-strip-types scripts/build-llms-txt.ts",
    "record": "node --experimental-strip-types scripts/record.ts",
    "study": "node --experimental-strip-types scripts/study.ts",
    "release-notes": "node --experimental-strip-types scripts/release-notes.ts",
    "test:cli": "node --experimental-strip-types bin/querylens.ts --help",
    "build:packages": "node --experimental-strip-types scripts/build-packages.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "d3-hierarchy": "3.1.2",
    "flowinger": "1.2.1",
    "html-to-image": "1.11.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.4",
    "vitest": "5.0.1"
  }
}
